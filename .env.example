# Copy to .env and fill in. NEVER commit the real .env file.

DJANGO_DEBUG=0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=devpulse
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# Optional: create a bot with @BotFather and paste the token
TELEGRAM_BOT_TOKEN=

MAX_MONITORS_PER_USER=20
